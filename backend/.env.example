# backend/.env.example: a TEMPLATE. Copy it to a file named  .env  (in this backend folder)
# and fill in real values. .env is in .gitignore so it is NEVER uploaded.
#
# THESE ARE REAL SECRETS. They must never go in the frontend.

# ---- Supabase (Dashboard -> Project Settings -> API Keys) ----
SUPABASE_URL=https://your-project-id.supabase.co
# The SECRET key (starts with sb_secret_), or the older "service_role" key.
# It bypasses all security rules, so keep it secret.
SUPABASE_SECRET_KEY=

# ---- Firebase (Project settings -> Service accounts -> Generate new private key) ----
# On your computer: put the downloaded .json file in this backend folder and give its name here.
# (Files named *serviceAccount*.json / firebase-adminsdk*.json are ignored by git.)
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-adminsdk.json
# On Hugging Face (Step 9) we'll paste the whole JSON text into this instead:
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Where the website lives (used for links inside alerts) ----
APP_URL=http://localhost:5173

# ---- A password Supabase's scheduler will use to call /alerts/run (make up a long random one) ----
CRON_SECRET=change-me-to-a-long-random-string

# ---- Alert timing ----
# Minutes at 2 km before growing to 5 km, and minutes at 5 km before growing to 10 km.
# (Use 1 and 1 while testing so you don't have to wait.)
EXPAND_TO_5KM_AFTER_MIN=30
EXPAND_TO_10KM_AFTER_MIN=60
# How often (seconds) the backend checks for alerts to send by itself. 0 = never (only when called).
ALERT_LOOP_SECONDS=120

# ---- Face matching ----
# "opencv" = fast and light; "retinaface" = more accurate, slower
FACE_DETECTOR=opencv
# 1 = load the AI model as soon as the server starts (slower start, faster first search)
FACE_PRELOAD=0

# ---- SMS fallback ----
# "log"      = don't really send; just print the SMS in the terminal (good for testing, free)
# "fast2sms" = send via Fast2SMS (Indian SMS service)
# "twilio"   = send via Twilio
SMS_PROVIDER=log
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
