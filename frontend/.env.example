# .env.example
# A TEMPLATE showing which settings the app needs. It's safe to share because it holds no real values.
#
# How to use it:
#   1. Make a copy of this file named exactly:  .env   (in this same frontend folder)
#   2. Put your real values in .env
#   3. Restart "npm run dev" after any change to .env
#   4. .env is listed in .gitignore, so it never gets uploaded
#
# Where to find the values: Supabase dashboard -> your project ->
#   "Connect" button (top of the page), or Project Settings -> API Keys
#
# IMPORTANT: Anything starting with VITE_ ends up inside the website,
# where anyone can see it. So only put PUBLIC values here:
#   - The "publishable" key (starts with sb_publishable_) is meant to be public.
#     If your project only shows an older "anon" key, that's fine too: use it here.
#     Row Level Security is what keeps the data safe.
#   - NEVER put the "secret" / "service_role" key, the Firebase
#     service-account file or SMS keys here. Those go in the backend only.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# The backend (face matching). On your computer: http://localhost:8000
# Once online: https://YOUR-HF-USERNAME-missing-person-finder.hf.space
VITE_BACKEND_URL=http://localhost:8000

# ---- Firebase (only for push notifications) ----
# Firebase console -> Project settings -> General -> "Your apps" -> Web app -> config
# These web settings are public by design (NOT the service-account key!).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings -> Cloud Messaging -> Web Push certificates -> "Key pair"
VITE_FIREBASE_VAPID_KEY=

# ---- Google Maps (the live map) ----
# Google Cloud console -> APIs & Services -> Credentials -> "Create credentials" -> API key
# Turn on "Maps JavaScript API". Restrict the key to Websites:
#   https://lumen.sabin-sanjay.workers.dev/*  and  http://localhost:5173/*
# A browser Maps key is public by design; the website restriction keeps it safe.
# Leave empty to use the free OpenStreetMap map instead.
VITE_GOOGLE_MAPS_KEY=
